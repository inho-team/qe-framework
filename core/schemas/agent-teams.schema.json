{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Teams Configuration Schema",
  "description": "JSON Schema for Claude Code Agent Teams --agents flag configuration",
  "type": "array",
  "items": {
    "$ref": "#/definitions/agentDefinition"
  },
  "definitions": {
    "agentDefinition": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique agent identifier"
        },
        "description": {
          "type": "string",
          "description": "Short description (3-5 words)"
        },
        "prompt": {
          "type": "string",
          "description": "System prompt for the agent"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed tools (e.g., Read, Write, Bash)"
        },
        "model": {
          "type": "string",
          "enum": ["haiku", "sonnet", "opus"],
          "description": "Model override for this agent"
        },
        "permissionMode": {
          "type": "string",
          "description": "Permission mode for the agent"
        },
        "mcpServers": {
          "type": "array",
          "items": { "type": "object" },
          "description": "MCP server configurations per agent"
        },
        "hooks": {
          "type": "object",
          "description": "Agent-specific hook overrides"
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum conversation turns"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available skills for the agent"
        },
        "initialPrompt": {
          "type": "string",
          "description": "First message sent to the agent on start"
        },
        "memory": {
          "type": "string",
          "description": "Memory/context configuration"
        },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "max"],
          "description": "Reasoning effort level"
        },
        "background": {
          "type": "boolean",
          "default": false,
          "description": "Run agent in background"
        },
        "isolation": {
          "type": "string",
          "enum": ["worktree"],
          "description": "Isolation mode (worktree for git worktree)"
        },
        "color": {
          "type": "string",
          "description": "Terminal color identifier"
        }
      }
    }
  }
}
