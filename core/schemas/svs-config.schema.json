{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIVS Engine Configuration Schema",
  "description": "JSON Schema for qe-framework v5.x SIVS (Spec-Implement-Verify-Supervise) engine configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "spec": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Spec stage"
    },
    "implement": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Implement stage"
    },
    "verify": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Verify stage"
    },
    "supervise": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Supervise stage"
    }
  },
  "definitions": {
    "stageConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["claude", "codex"],
          "default": "claude",
          "description": "AI engine to handle this SIVS stage"
        },
        "model": {
          "type": "string",
          "description": "Optional model override (e.g., 'gpt-5.4-mini' for codex engine)"
        },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "description": "Reasoning effort level (Claude: low/medium/high/max, Codex: low/medium/high/xhigh)"
        },
        "background": {
          "type": "boolean",
          "default": false,
          "description": "For Codex stages, run through codex-plugin-cc background mode and retrieve results with /codex:status and /codex:result"
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable compaction API integration"
            },
            "strategy": {
              "type": "string",
              "enum": ["server", "client", "auto"],
              "default": "auto",
              "description": "Compaction strategy: server (API-side), client (local), auto (best available)"
            }
          }
        }
      }
    }
  }
}
