{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIVS Single-AI Role Configuration Schema",
  "description": "JSON Schema for qe-framework SIVS single-AI role configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Single-AI role configuration format."
    },
    "spec": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Spec stage"
    },
    "implement": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Implement stage"
    },
    "verify": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Verify stage"
    },
    "supervise": {
      "$ref": "#/definitions/stageConfig",
      "description": "Configuration for the Supervise stage"
    }
  },
  "definitions": {
    "stageConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "Optional active-client model override"
        },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "description": "Reasoning effort level for the active client"
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable compaction API integration"
            },
            "strategy": {
              "type": "string",
              "enum": ["server", "client", "auto"],
              "default": "auto",
              "description": "Compaction strategy: server (API-side), client (local), auto (best available)"
            }
          }
        }
      }
    }
  }
}
