{
  "name": "@inho-team/qe-framework",
  "version": "11.0.0",
  "private": true,
  "description": "QE Framework — a Claude Code plugin with one workflow (이해 → 계획 → 실행 → 검증 → 마무리), specialist agents, task plans, and verification records",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "lint": "node scripts/lint-hooks.mjs",
    "test": "npm run lint && node --test",
    "eval:trigger": "claude plugin eval . --tag trigger --ablation none --threshold 0.66 --no-publish --trust-plugin -j 3",
    "eval:gate": "claude plugin eval . --tag gate --threshold 0.66 --allow-tools Write Edit --no-publish --trust-plugin -j 3",
    "eval:codebase-memory": "node evals/run-codebase-memory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inho-team/qe-framework.git"
  },
  "homepage": "https://github.com/inho-team/qe-framework#readme",
  "bugs": {
    "url": "https://github.com/inho-team/qe-framework/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  }
}
